{
  "name": "smartfill",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "SmartFill - job application autofill Chrome extension",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:ui && npm run build:content",
    "build:ui": "vite build",
    "build:content": "vite build --config vite.content.config.ts",
    "icons": "node scripts/generate-icons.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "jsdom": "^25.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
